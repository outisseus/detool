{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/outisseus/detool/main/schemas/access-decision.json",
  "title": "AccessDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "request_id", "capability_id", "decision", "reason_code", "policy_version", "decided_at"],
  "properties": {
    "decision_id": {"type": "string"},
    "request_id": {"type": "string"},
    "capability_id": {"type": "string"},
    "decision": {"enum": ["allow", "deny", "challenge"]},
    "reason_code": {"type": "string"},
    "policy_version": {"type": "string"},
    "constraints": {"type": "object"},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
